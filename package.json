{
  "name": "dsh-git-plus",
  "version": "0.1.45",
  "description": "dsh panel plugin: sidebar git management — Local Changes / All Commits, branch/tag/stash management, merge with conflict handling.",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitxeno/dsh-git-plus.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/host",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "deploy:local": "npm run build && rsync -a --delete --delete-excluded --exclude 'testkit.mjs' --exclude 'hookkit.mjs' lib/ ~/.dsh/profiles/web/node_modules/dsh-git-plus/lib/ && echo 'Deployed to ~/.dsh/profiles/web/node_modules/dsh-git-plus/lib — refresh the GUI to load the new client.js (restart dsh web for host-half changes)'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node build.mjs && node --test --test-force-exit test/unit/*.test.mjs",
    "test": "npm run test:unit",
    "check": "npm run typecheck && npm run test"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "codejar": "^4.3.0"
  }
}
